# Copy to .env. Never commit .env.

# Optional. Rotating proxy gateway, e.g. http://user:pass@gate.example.com:7000
PROXY_URL=

# Optional. Captcha solver: anticaptcha | capmonster | 2captcha
CAPTCHA_PROVIDER=
CAPTCHA_API_KEY=

# Required for authenticated endpoints: 32+ random chars, encrypts saved sessions.
SESSION_KEY=
