# Copy to .env. Never commit .env.

# Optional. Proxy for every request, e.g. http://user:pass@gate.example.com:7000
# If your provider takes a session id in the username, put {session} there:
#   http://user-session-{session}:pass@gate.example.com:7000
# sitescrape then rotates the IP per call, and keeps it fixed for logged-in sites.
PROXY_URL=

# Optional. Captcha solver: anticaptcha | capmonster | 2captcha
CAPTCHA_PROVIDER=
CAPTCHA_API_KEY=

# Required for `sitescrape login`: 16+ random chars, encrypts saved logins.
SESSION_KEY=

# Required by `sitescrape serve` when binding to a non-local address.
SITESCRAPE_TOKEN=
